# Copie para .env e preencha. .env e secrets ficam fora do git.

# Token de System User do Business Manager (longa duração).
# Permissões: instagram_basic, instagram_manage_insights, pages_show_list,
# pages_read_engagement, business_management
# Para a stream comment também: instagram_manage_comments (concedida em 14/10).
# O autor do comentário exige AINDA a task MODERATE na página ligada — pendência P1b:
# hoje só a Texaco tem. Sem a task, username e from voltam vazios, sem erro.
IG_ACCESS_TOKEN=

# Uma conta por conexão (D2). O id sai de
# /me/accounts?fields=instagram_business_account{id,username}
# texacolubrificantes 17841408010423009 · loteriascaixaoficial 17841407270613285
# caixa 17841401357494265 · binder 17841404676020635 · caixainveste 17841442952681475
IG_BUSINESS_ACCOUNT_ID=

# Corte histórico duro (YYYY-MM-DD). Pedido anterior ao limite da plataforma é truncado.
IG_START_DATE=2025-01-01

# Janelas (dias)
IG_LOOKBACK_WINDOW_DAYS=28
IG_COMMENT_WINDOW_DAYS=90

# Teto de idade de mídia para insights (D13). Acima disso a plataforma já degradou o
# número: reach de 1.666 volta como 81 e views volta 0. Não é economia, é integridade.
IG_INSIGHTS_MAX_AGE_DAYS=700

# Janela da demografia de seguidores: last_14_days, last_30_days, last_90_days,
# prev_month, this_month, this_week
IG_DEMOGRAPHICS_TIMEFRAME=last_30_days

# Versão da Graph API (D19)
IG_API_VERSION=v26.0
